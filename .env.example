# =====================================================================
# TrackShift Copilot — Environment Configuration (.env.example)
# =====================================================================

# Optional: Google Gemini API Key for Pit Radio natural-language synthesis
# If left empty/unset, the Strategy Orchestrator automatically uses its deterministic template engine.
GEMINI_API_KEY=

# Optional: Server host and port configuration (default: 127.0.0.1:8000)
PORT=8000
HOST=127.0.0.1

# Optional: Path to FastF1 telemetry disk cache directory (default: backend/backtesting/.fastf1_cache)
FASTF1_CACHE_DIR=backend/backtesting/.fastf1_cache
